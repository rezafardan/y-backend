# # Ignore everything in public/assets
# /public/assets/*

# # Include specific folders
# !/public/assets/blog/
# !/public/assets/blog/content/
# !/public/assets/profile-image/

# # Ignore contents of included folders, but allow .gitkeep
# /public/assets/blog/*
# !/public/assets/blog/.gitkeep

# /public/assets/blog/content/*
# !/public/assets/blog/content/.gitkeep

# /public/assets/profile-image/*
# !/public/assets/profile-image/.gitkeep

# KEAMANAN CI/CD: jangan pernah hapus ".env" di bawah — itu satu-satunya
# proteksi supaya DATABASE_URL, ACCESS_TOKEN_SECRET, dll tidak ikut ter-commit.
# "dist" juga wajib tetap di-ignore: image Docker meng-compile ulang lewat
# `npx tsc` di build stage, bukan memakai folder dist lokal yang bisa basi.
# General ignores
node_modules
.env
.vercel
dist
